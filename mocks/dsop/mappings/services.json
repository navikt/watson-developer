    {
      "name": "SAF document download: synthetic PDF",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPathPattern": "/saf/rest/hentdokument/[^/]+/dsop-local/ARKIV"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/pdf",
          "Content-Disposition": "inline; filename=syntetisk.pdf"
        },
        "bodyFileName": "syntetisk.pdf"
      }
