    {
      "name": "Dokarkiv creates local incoming journalpost",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/dokarkiv/rest/journalpostapi/v1/journalpost",
        "queryParameters": { "forsoekFerdigstill": { "equalTo": "true" } },
        "bodyPatterns": [
          { "matchesJsonPath": { "expression": "$.journalpostType", "equalTo": "INNGAAENDE" } }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "journalpostId": "900000001", "journalpostferdigstilt": true }
      }
    },
    {
      "name": "Dokarkiv creates local outgoing journalpost",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/dokarkiv/rest/journalpostapi/v1/journalpost",
        "queryParameters": { "forsoekFerdigstill": { "equalTo": "true" } },
        "bodyPatterns": [
          { "matchesJsonPath": { "expression": "$.journalpostType", "equalTo": "UTGAAENDE" } }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "journalpostId": "900000002", "journalpostferdigstilt": true }
      }
    },
    {
      "name": "Dokarkiv marks local journalpost exported",
      "priority": 1,
      "request": {
        "method": "PATCH",
        "urlPathPattern": "/dokarkiv/rest/journalpostapi/v1/journalpost/(900000001|900000002)/oppdaterDistribusjonsinfo"
      },
      "response": { "status": 200 }
    },
