{
  "$schema": "https://raw.githubusercontent.com/navikt/fnr-guard/main/schema/fnr-guard.schema.json",
  "versjon": 1,
  // watson-developer selv, og alle repoene som er klonet til repos/
  "roots": [".", "repos/*"],
  "include": ["**"],
  "exclude": [
    { "mønster": "**/node_modules/**", "begrunnelse": "Tredjepartskode installert av npm og pnpm" },
    { "mønster": "**/build/**", "begrunnelse": "Byggeresultat generert av Gradle" },
    { "mønster": "**/dist/**", "begrunnelse": "Byggeresultat generert av Vite" }
  ],
  "ekstraBlokkerteTyper": [],
  "pdf": true,
  "maksFilstørrelseKb": 2048,
  "manglendeNode": "stopp"
}
